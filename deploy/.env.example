# FlagMesh environment variables.
#
# Copy this file to .env in the same folder and fill in real values.
# .env is ignored by Git. Never commit real secrets.
#
# Docker Compose reads deploy/.env automatically.
# For IntelliJ (control-plane) and GoLand (sidecar), add the same variables
# to the run configuration: Run Configuration > Modify options > Environment variables.
#
# Local host ports (chosen so FlagMesh and PayCore can run side by side):
#   FlagMesh: PostgreSQL 5433, Redis 6380, control-plane 8081, sidecar 9090
#   PayCore:  PostgreSQL 5432, Redis 6379, Kafka 9092, payment-service 8080

# --- Docker Compose project name ---
# Both repos keep compose in a folder named "deploy". Without this, Compose would
# use "deploy" as the project name for BOTH stacks and they would replace each other.
COMPOSE_PROJECT_NAME=flagmesh

# --- JVM (Spring services) ---
# Run the JVM in UTC. Without this, Windows reports India's zone as the legacy name
# "Asia/Calcutta", which the postgres:17 image rejects (FATAL: invalid value for
# parameter "TimeZone"). Every java process reads JAVA_TOOL_OPTIONS automatically.
JAVA_TOOL_OPTIONS=-Duser.timezone=UTC

# --- Local PostgreSQL container (docker-compose) ---
POSTGRES_DB=flagmesh_db
POSTGRES_USER=flagmesh
POSTGRES_PASSWORD=change-me

# --- control-plane: database ---
# Local now. At deployment (Phase 12), Neon's DIRECT host (no "-pooler"):
#   jdbc:postgresql://<neon-host>/<db>?sslmode=require
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5433/flagmesh_db
SPRING_DATASOURCE_USERNAME=flagmesh
SPRING_DATASOURCE_PASSWORD=change-me

# --- control-plane: Redis Pub/Sub (publishes to flags:updates) ---
# Local now. At deployment (Phase 12), Upstash over TLS (note the double "s"):
#   rediss://default:<password>@<upstash-endpoint>:6379
SPRING_DATA_REDIS_URL=redis://localhost:6380

# --- control-plane: HTTP port (payment-service already uses 8080) ---
SERVER_PORT=8081

# --- sidecar (Go) ---
REDIS_URL=redis://localhost:6380
CONTROL_PLANE_URL=http://localhost:8081

# --- Datadog logs (Phase 3) ---
# DD_SITE is the site you signed up on: datadoghq.com, us3.datadoghq.com,
# us5.datadoghq.com, datadoghq.eu or ap1.datadoghq.com.
DD_API_KEY=
DD_SITE=datadoghq.com
